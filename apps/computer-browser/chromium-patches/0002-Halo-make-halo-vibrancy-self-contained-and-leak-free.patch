+void BrowserNativeWidgetMac::UpdateHaloVibrancy() {
+  // At most one blur/tint pair per window. Eligibility changes (fullscreen,
+  // activation, battery saver, pref) must not add more.
+  if (halo_blur_view_ || !IsHaloVibrancyEnabled() || !GetNSWindowHost()) {
+    return;
+  }
+
+  NSWindow* const ns_window = GetNSWindowHost()->GetInProcessNSWindow();
+  if (!ns_window) {
+    return;
+  }
+
+  const std::optional<int> halo_width = halo::GetVibrancyWidth();
+  if (!halo_width.has_value()) {
+    return;
+  }
+
+  // A fully transparent background ([NSColor clearColor]) causes AppKit to
+  // continuously invalidate the window surface, resulting in high CPU and
+  // energy usage. Using an almost-transparent color (alpha 0.001) avoids this
+  // performance issue while remaining visually indistinguishable. See also
+  // UpdateGlassEligibility().
+  GetNSWindowHost()->SetLayerAndCompositorOpaque(false);
+  [ns_window setOpaque:NO];
+  [ns_window setBackgroundColor:[[NSColor windowBackgroundColor]
+                                    colorWithAlphaComponent:0.001]];
+  ns_window.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  ns_window.titlebarAppearsTransparent = YES;
+
+  NSView* const content_view = [ns_window contentView];
+  // Parent the blur to the frame view so it also covers the title bar.
+  NSView* const blur_parent =
+      content_view.superview ? content_view.superview : content_view;
+  const bool is_rtl = base::i18n::IsRTL();
+  const NSRect halo_frame =
+      NSMakeRect(is_rtl ? blur_parent.bounds.size.width - *halo_width : 0, 0,
+                 *halo_width, blur_parent.bounds.size.height);
+
+  NSVisualEffectView* const blur =
+      [[HaloVibrancyView alloc] initWithFrame:halo_frame];
+  blur.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  blur.material = NSVisualEffectMaterialSidebar;
+  blur.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+  blur.state = NSVisualEffectStateActive;
+  blur.autoresizingMask =
+      (is_rtl ? NSViewMinXMargin : NSViewMaxXMargin) | NSViewHeightSizable;
+  [blur_parent addSubview:blur
+               positioned:NSWindowBelow
+               relativeTo:blur_parent == content_view ? nil : content_view];
+  halo_blur_view_ = blur;
+
+  // Halo: tint the blur like the page's own scrim so the sliver of blur
+  // outside the page's rounded corners matches the sidebar colour.
+  // --halo-vibrancy-tint=r,g,b,a (0-255 channels, 0-1 alpha).
+  const std::string tint_spec =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "halo-vibrancy-tint");
+  const std::vector<std::string> halo_tint = base::SplitString(
+      tint_spec, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  double tr = 0, tg = 0, tb = 0, ta = 0;
+  if (halo_tint.size() == 4 && base::StringToDouble(halo_tint[0], &tr) &&
+      base::StringToDouble(halo_tint[1], &tg) &&
+      base::StringToDouble(halo_tint[2], &tb) &&
+      base::StringToDouble(halo_tint[3], &ta)) {
+    NSView* const halo_tint_view =
+        [[HaloVibrancyTintView alloc] initWithFrame:blur.frame];
+    halo_tint_view.wantsLayer = YES;
+    halo_tint_view.layer.backgroundColor = [NSColor colorWithSRGBRed:tr / 255.0
+                                                               green:tg / 255.0
+                                                                blue:tb / 255.0
+                                                               alpha:ta]
+                                               .CGColor;
+    halo_tint_view.autoresizingMask = blur.autoresizingMask;
+    [blur_parent addSubview:halo_tint_view
+                 positioned:NSWindowAbove
+                 relativeTo:blur];
+    halo_tint_view_ = halo_tint_view;
+  }
+}
