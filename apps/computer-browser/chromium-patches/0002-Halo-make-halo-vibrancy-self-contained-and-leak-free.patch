--- /dev/null
+++ b/chrome/browser/ui/views/frame/halo_vibrancy.h
@@ -0,0 +1,51 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_HALO_VIBRANCY_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_HALO_VIBRANCY_H_
+
+#include <optional>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+
+namespace halo {
+
+// Halo draws its desktop UI in an --app window and asks Chromium for native
+// vibrancy behind the leading column of that window with this switch.
+inline constexpr char kHaloVibrancyWidthSwitch[] = "halo-vibrancy-width";
+
+// Returns the requested vibrancy gutter width, or nullopt if the switch is
+// absent or its value is not a positive integer. A malformed value disables
+// the feature instead of producing a chromeless, transparent window with no
+// blur behind it.
+inline std::optional<int> GetVibrancyWidth() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kHaloVibrancyWidthSwitch)) {
+    return std::nullopt;
+  }
+  int width = 0;
+  if (!base::StringToInt(
+          base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+              kHaloVibrancyWidthSwitch),
+          &width) ||
+      width <= 0) {
+    return std::nullopt;
+  }
+  return width;
+}
+
+// Returns true if the native vibrancy treatment should be applied to
+// `browser`. The switch is process-global, so the treatment is limited to
+// Halo's --app window; other windows in the same process (popups, devtools,
+// extension windows, ...) keep upstream behavior.
+inline bool IsVibrancyEnabledForBrowser(const BrowserWindowInterface* browser) {
+  return browser && browser->GetType() == BrowserWindowInterface::TYPE_APP &&
+         GetVibrancyWidth().has_value();
+}
+
+}  // namespace halo
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_HALO_VIBRANCY_H_
