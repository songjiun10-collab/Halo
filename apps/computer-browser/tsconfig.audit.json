{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "shared/harness-contracts.js",
    "shared/task-profile-contracts.js",
    "shared/harness-profile.js",
    "shared/capability-registry.js",
    "type-tests/**/*.ts"
  ]
}
