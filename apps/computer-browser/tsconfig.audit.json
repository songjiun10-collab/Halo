{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "runtime-src/shared/harness-contracts.ts",
    "runtime-src/shared/task-profile-contracts.ts",
    "runtime-src/shared/harness-profile.ts",
    "runtime-src/shared/capability-registry.ts",
    "type-tests/**/*.ts"
  ]
}
