# Phase 1: TLS reverse proxy in front of the Halo gateway, plus the static
# front-end console at "/". No API routes are wired up. /approve, /execute,
# /revoke, /healthz stay loopback-only (the gateway container is only
# published on 127.0.0.1:8080 -- see compose.yaml). Every path other than
# exactly "/" 404s -- there is nothing else here for the public internet to
# reach. The console page itself defaults to a client-side-only simulation
# (api.mode='simulation' in web/halo-console.html) and never calls fetch;
# it does not depend on this Caddyfile exposing anything beyond static file
# serving. See docs/DEPLOY.ko.md for the Phase 2 plan (a narrow /public/hash
# wrapper) that this file deliberately does not wire up without separate
# approval.
{
	email YOUR-EMAIL@example.com   # Let's Encrypt expiry/problem notices -- replace
}

# REPLACE-ME: your DuckDNS hostname, e.g. myhalo.duckdns.org
REPLACE-ME.duckdns.org {
	handle / {
		root * REPLACE-WITH-ABSOLUTE-PATH-TO/Halo/web
		rewrite * /halo-console.html
		file_server
	}

	handle {
		respond 404
	}

	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /opt/homebrew/var/log/caddy/halo-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
